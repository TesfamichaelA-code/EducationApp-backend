# Runtime
NODE_ENV=development
PORT=8001

# CORS — comma-separated origins (e.g. https://app.example.com,http://localhost:3000)
# Required when NODE_ENV=production.
FRONTEND_ORIGIN=

# Swagger UI at /api/docs — defaults to on outside production, off in production
# ENABLE_SWAGGER=false

# Google Gemini — get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Max AI requests per user per UTC day (admins exempt)
AI_DAILY_LIMIT=50

# Database
MONGO_URL=mongodb://localhost:27017
DB_NAME=learndeck

# Auth secrets — 32+ random chars each, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Admin account seeded on boot. Use a unique, strong password in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin
